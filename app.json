{
  "expo": {
    "name": "TurnoFacil",
    "slug": "turnofacil",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turnofacil.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TurnoFácil usa tu ubicación para mostrarte qué tan lejos estás de la barbería.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.turnofacil.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TurnoFácil usa tu ubicación para mostrarte qué tan lejos estás de la barbería."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBFzjZYzRIL2Hi3Qj9VyioRtuWM-80A8nM"
        }
      ]
    ],
    "owner": "santicollazos15",
    "extra": {
      "eas": {
        "projectId": "3cd77294-5aad-4ff4-ae3a-d46135b5feee"
      }
    }
  }
}
