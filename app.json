{
  "expo": {
    "name": "TurnoFacil",
    "slug": "turnofacil",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turnofacil.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TurnoFácil usa tu ubicación para mostrarte qué tan lejos estás de la barbería.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.turnofacil.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TurnoFácil usa tu ubicación para mostrarte qué tan lejos estás de la barbería."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBFzjZYzRIL2Hi3Qj9VyioRtuWM-80A8nM"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7c80c2c7-13f8-4e43-b773-8c11c3606e4a"
      }
    },
    "owner": "brayancuervo"
  }
}
